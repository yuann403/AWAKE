                        android:layout_weight="1">

                        <ImageButton
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_centerInParent="true"
                            android:background="@color/white"
                            android:onClick="changeToIntroduceDetailPage11"
