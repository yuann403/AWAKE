<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity"
    android:orientation="vertical"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center"
        android:text="@string/user_name"
        android:textSize = "24sp"
        android:textColor="@color/black"
        android:background="@color/app_color"
        />
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        >
        <ImageView
            android:id="@+id/title_line_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="20dp"
            android:src="@drawable/title_line" />

        <TextView
            android:id="@+id/game_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="30dp"
            android:text="@string/user_name"
            android:textColor="@color/black"
            android:textSize="18sp"

            />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="6.9"
        >

        <RelativeLayout
            android:id="@+id/t01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/analyze_detail_style"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/h01"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="語言設定"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/h01"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:text="繁體中文"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/t02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/t01"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/analyze_detail_style"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/h02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="版本"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/h02"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:text="1.0.1"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/t03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/t02"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/analyze_detail_style"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/h03"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="帳號"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/h03"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:text="gmail.com"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/t04"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/t03"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/analyze_detail_style"
            android:orientation="horizontal"
            android:onClick="logout">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/logout"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </RelativeLayout>
    </RelativeLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@color/app_color"
        >

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/home_Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:background="@color/app_color"
                android:onClick="changeToMainPage"
                android:scaleType="fitEnd"
                android:src="@drawable/home_icon" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/study_Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:background="@color/app_color"
                android:onClick="changeToStudyPage"
                android:scaleType="fitEnd"
                android:src="@drawable/study_icon" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/statistics_Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:background="@color/app_color"
                android:onClick="changeToStatisticsPage"
                android:scaleType="fitEnd"
                android:src="@drawable/statistics_icon" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/user_Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:background="@color/app_color"
                android:onClick="changeToHomePage"
                android:scaleType="fitEnd"
                android:src="@drawable/user_icon" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>