<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/study_listview"
        android:onClick="changeToAnalyzePage"
        >
        <TextView
            android:id="@+id/history_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            />

        <TextView
            android:id="@+id/history_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:textColor="@color/app_date_color"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/history_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/history_date"
            android:layout_marginLeft="30dp"
            android:layout_toRightOf="@id/history_date"
            android:textColor="@color/app_game_color"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/video_play_img"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_alignBottom="@id/history_date"

            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@id/history_video_time"
            android:scaleType="fitEnd"
            android:src="@drawable/play_btn"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/history_video_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/history_date"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:text="@string/test_time"
            android:textColor="@color/app_time_color"
            android:textSize="16sp"
            android:visibility="invisible"/>
    </RelativeLayout>

</LinearLayout>

